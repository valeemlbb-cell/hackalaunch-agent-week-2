# Copy to .env and fill in. NEVER commit a real .env or a keypair file.

# Solana RPC used for anchoring and verification.
# agentproof refuses any endpoint that is not devnet / testnet / localnet.
AGENTPROOF_RPC_URL=https://api.devnet.solana.com

# Absolute path to a Solana CLI keypair JSON file (array of 64 numbers) that
# pays the ~0.000005 SOL devnet fee per anchor transaction.
# Keep this OUTSIDE the repository. Create one with:
#   solana-keygen new --outfile ~/.config/solana/agentproof-devnet.json
# then fund it at https://faucet.solana.com (devnet).
AGENTPROOF_KEYPAIR=/absolute/path/outside/this/repo/agentproof-devnet.json

# Where the append-only ledger lives (default: .agentproof)
AGENTPROOF_DIR=.agentproof

# Port for the local approval dashboard (binds 127.0.0.1 only)
AGENTPROOF_PORT=4319
